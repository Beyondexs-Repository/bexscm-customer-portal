{
  "defaultRoutes": {
    "global-admin": "/backoffice",
    "application-admin": "/backoffice",
    "sales-rep": "/backoffice",
    "sales-associate": "/backoffice",
    "gm-owners": "/backoffice",
    "ar": "/backoffice",
    "ar-manager": "/backoffice",
    "store-manager": "/",
    "store-employee": "/"
  },
  "pages": [
    {
      "id": "overview",
      "title": "Overview",
      "titleKey": "overview",
      "routes": {
        "customer": "/",
        "backoffice": "/backoffice"
      },
      "aliases": {
        "backoffice": ["/backoffice/overview"]
      }
    },
    {
      "id": "order-guide",
      "title": "Order Guide",
      "titleKey": "orderGuide",
      "routes": {
        "customer": "/order-guide",
        "backoffice": "/backoffice/order-guide"
      }
    },
    {
      "id": "catalog",
      "title": "Catalog",
      "titleKey": "catalog",
      "matchPrefix": true,
      "routes": {
        "customer": "/catalog",
        "backoffice": "/backoffice/catalog"
      }
    },
    {
      "id": "my-orders",
      "title": "My Orders",
      "titleKey": "myOrders",
      "routes": {
        "customer": "/my-orders",
        "backoffice": "/backoffice/my-orders"
      }
    },
    {
      "id": "messages",
      "title": "Messages",
      "titleKey": "messages",
      "routes": {
        "customer": "/messages"
      }
    },
    {
      "id": "employees",
      "title": "Employees",
      "titleKey": "employees",
      "routes": {
        "customer": "/employees",
        "backoffice": "/backoffice/employees"
      }
    },
    {
      "id": "users",
      "title": "Users",
      "titleKey": "users",
      "routes": {
        "backoffice": "/backoffice/users"
      }
    },
    {
      "id": "roles-permissions",
      "title": "Roles and Permissions",
      "routes": {
        "backoffice": "/backoffice/roles-permissions"
      }
    },
    {
      "id": "promotions",
      "title": "Promotions",
      "routes": {
        "backoffice": "/backoffice/promotions"
      }
    },
    {
      "id": "profile",
      "title": "Profile",
      "titleKey": "profile",
      "routes": {
        "customer": "/profile",
        "backoffice": "/backoffice/profile"
      }
    }
  ],
  "permissions": {
    "global-admin": {
      "areas": ["backoffice"],
      "pages": [
        "overview",
        "my-orders",
        "catalog",
        "users",
        "employees",
        "roles-permissions",
        "profile",
        "promotions"
      ],
      "actions": [
        "addToCart",
        "addToOrderGuide",
        "clearChat",
        "createCatalog",
        "createEmployee",
        "createUser",
        "deleteCatalog",
        "deleteEmployee",
        "deleteUser",
        "editCatalog",
        "editEmployee",
        "editOrder",
        "editUser",
        "placeOrder",
        "publishCatalog",
        "viewAllOrders"
      ]
    },
    "application-admin": {
      "areas": ["backoffice"],
      "pages": [
        "overview",
        "my-orders",
        "catalog",
        "users",
        "employees",
        "roles-permissions",
        "profile"
      ],
      "actions": [
        "createCatalog",
        "createUser",
        "editCatalog",
        "editOrder",
        "editUser",
        "placeOrder",
        "publishCatalog",
        "viewAllOrders"
      ]
    },
    "sales-rep": {
      "areas": ["backoffice"],
      "pages": ["overview", "orders", "order-guide", "catalog", "profile"],
      "actions": ["editOrder", "placeOrder", "viewAllOrders", "addToOrderGuide", "createOrderGuide", "deleteOrderGuide", "createUser"]
    },
    "sales-associate": {
      "areas": ["backoffice"],
      "pages": ["overview", "orders", "catalog", "profile"],
      "actions": ["editOrder", "placeOrder", "viewAllOrders"]
    },
    "gm-owners": {
      "areas": ["backoffice"],
      "pages": ["overview", "orders", "catalog", "profile"],
      "actions": ["editOrder", "placeOrder", "viewAllOrders"]
    },
    "ar": {
      "areas": ["backoffice"],
      "pages": ["overview", "orders", "catalog", "profile"],
      "actions": ["viewAllOrders"]
    },
    "ar-manager": {
      "areas": ["backoffice"],
      "pages": ["overview", "orders", "catalog", "profile"],
      "actions": ["viewAllOrders"]
    },
    "store-manager": {
      "areas": ["customer"],
      "pages": [
        "overview",
        "order-guide",
        "catalog",
        "my-orders",
        "messages",
        "employees",
        "profile"
      ],
      "actions": [
        "addProductToOrderGuide",
        "addToCart",
        "addToOrderGuide",
        "clearChat",
        "createEmployee",
        "createOrderGuide",
        "createUser",
        "deleteEmployee",
        "deleteOrderGuide",
        "downloadInvoice",
        "editEmployee",
        "editOrderGuide",
        "editUser",
        "placeOrder",
        "reorder",
        "searchMessages",
        "viewOrderDetails"
      ]
    },
    "store-employee": {
      "areas": ["customer"],
      "pages": [
        "overview",
        "order-guide",
        "catalog",
        "my-orders",
        "messages",
        "employees",
        "profile"
      ],
      "actions": [
        "addProductToOrderGuide",
        "addToCart",
        "addToOrderGuide",
        "createOrderGuide",
        "editOrderGuide",
        "placeOrder",
        "reorder",
        "searchMessages",
        "viewOrderDetails"
      ]
    }
  },
  "menus": {
    "customer": ["overview",  "order-guide", "catalog", "my-orders", "employees", "messages"],
    "backoffice": ["overview", "order-guide", "catalog", "users", "promotions"]
  },
  "footerMenus": {
    "customer": ["overview", "order-guide", "catalog", "my-orders", "messages"],
    "backoffice": ["overview", "catalog", "order-guide", "users"]
  }
}
